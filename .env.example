# ngit-grasp Configuration
#
# Configuration Priority (highest to lowest):
# 1. CLI flags (e.g., --domain example.com)
# 2. Environment variables (e.g., NGIT_DOMAIN=example.com)  
# 3. This .env file
# 4. Built-in defaults
#
# Run `ngit-grasp --help` for all CLI options

# ============================================================================
# REQUIRED
# ============================================================================

# Domain where this instance is hosted (required, used in GRASP validation)
# CLI: --domain <domain>
# No default - must be set
# NGIT_DOMAIN=

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Server bind address (IP:PORT)
# CLI: --bind-address <address>
# Default: 127.0.0.1:7334
# NGIT_BIND_ADDRESS=127.0.0.1:7334

# ============================================================================
# RELAY INFORMATION (NIP-11)
# ============================================================================

# Relay operator's nsec (private key) for signing and authentication
# Used for:
# - NIP-11 relay information document (pubkey field derived from this nsec)
# - NIP-42 authentication when syncing from other relays
# - Future: signing events, WoT-based rate limiting of syncing relays
#
# CLI: --relay-owner-nsec <nsec>
# Default: Loaded from/saved to .relay-owner.nsec file in current directory
#          If file doesn't exist, a new key is generated and saved automatically
# NGIT_RELAY_OWNER_NSEC=nsec1...

# Relay name shown in NIP-11 information document
# CLI: --relay-name <name>
# Default: ${domain} grasp relay (e.g., "gitnostr.com grasp relay")
# NGIT_RELAY_NAME=My GRASP Relay

# Relay description shown in NIP-11 information document
# CLI: --relay-description <description>
# Default: Git Nostr Relay - a grasp implementation
# NGIT_RELAY_DESCRIPTION="A GRASP-compliant Git relay with Nostr authorization"

# ============================================================================
# STORAGE
# ============================================================================

# Path to store Git repositories
# CLI: --git-data-path <path>
# Default: ./data/git
# NGIT_GIT_DATA_PATH=./data/git

# Path to store Nostr relay data
# CLI: --relay-data-path <path>
# Default: ./data/relay
# NGIT_RELAY_DATA_PATH=./data/relay

# Database backend for Nostr events
# CLI: --database-backend <backend>
# Options: lmdb, memory
# Default: lmdb
#   - lmdb: LMDB backend (persistent, general purpose) - RECOMMENDED
#   - memory: In-memory database (fastest, no persistence, uses temp dirs)
#
# Note: When using 'memory' backend, git_data_path and relay_data_path
# are automatically set to temporary directories for ephemeral testing.
# NGIT_DATABASE_BACKEND=lmdb

# ============================================================================
# METRICS
# ============================================================================

# Enable Prometheus metrics endpoint at /metrics
# CLI: --metrics-enabled
# Default: true
# NGIT_METRICS_ENABLED=true

# Connections per IP before flagging as potential abuse in metrics
# (display only, no rate limiting - purely for monitoring visibility)
# CLI: --metrics-connection-per-ip-abuse-threshold <count>
# Default: 10
# NGIT_METRICS_CONNECTION_PER_IP_ABUSE_THRESHOLD=10

# Number of top bandwidth repositories to track in metrics
# CLI: --metrics-top-n-repos <count>
# Default: 10
# NGIT_METRICS_TOP_N_REPOS=10

# ============================================================================
# LOGGING
# ============================================================================

# Log level for application logging
# CLI: --log-level <level>
# Default: info
# Options: error, warn, info, debug, trace
# Can also use filter expressions: ngit_grasp=debug,actix_web=info
# NGIT_LOG_LEVEL=info

# ============================================================================
# PROACTIVE SYNC (GRASP-02)
# ============================================================================

# Bootstrap relay URL for initial sync (optional)
# Additional relays are automatically discovered from repository announcements
# that list our service domain.
# CLI: --sync-bootstrap-relay-url <url>
# Default: (none - relay discovery from stored announcements only)
# NGIT_SYNC_BOOTSTRAP_RELAY_URL=wss://relay.example.com

# Maximum backoff time in seconds for sync relay reconnection
# CLI: --sync-max-backoff-secs <seconds>
# Default: 3600 (1 hour)
# NGIT_SYNC_MAX_BACKOFF_SECS=3600

# Interval in seconds for checking disconnected relays and attempting reconnection
# Set to lower value for faster reconnection testing
# CLI: --sync-disconnect-check-interval-secs <seconds>
# Default: 60
# NGIT_SYNC_DISCONNECT_CHECK_INTERVAL_SECS=60

# Base backoff time in seconds for relay reconnection
# Used for exponential backoff: base * 2^(failures-1)
# Set to 1 for faster test cycles
# Note: The connection timeout is capped at this value
# CLI: --sync-base-backoff-secs <seconds>
# Default: 5
# NGIT_SYNC_BASE_BACKOFF_SECS=5

# Disable NIP-77 negentropy sync (use REQ+EOSE instead)
# When enabled, sync will use REQ+EOSE instead of negentropy for history sync
# Primarily useful for testing that sync works without negentropy support
# CLI: --sync-disable-negentropy
# Default: false
# NGIT_SYNC_DISABLE_NEGENTROPY=false

# ============================================================================
# REJECTED EVENTS INDEX
# ============================================================================

# Hot cache duration in seconds for rejected announcements
# Stores full event objects for immediate re-processing when dependencies resolve
# Too short (<30s): Miss events from slow relays
# Too long (>5min): Waste memory
# CLI: --rejected-hot-cache-duration-secs <seconds>
# Default: 120 (2 minutes)
# NGIT_REJECTED_HOT_CACHE_DURATION_SECS=120

# Cold index expiry in seconds for rejected announcements
# Stores metadata only to prevent repeated downloads of rejected events
# CLI: --rejected-cold-index-expiry-secs <seconds>
# Default: 604800 (7 days)
# NGIT_REJECTED_COLD_INDEX_EXPIRY_SECS=604800

# Hours before removing relay from naughty list
# Relays with persistent infrastructure issues (DNS, TLS, protocol errors) are
# tracked separately and retried after this expiration period
# CLI: --naughty-list-expiration-hours <hours>
# Default: 12
# NGIT_NAUGHTY_LIST_EXPIRATION_HOURS=12

# ============================================================================
# HOLDING DB AND DELETION-REQUEST CLEANUP
# ============================================================================

# Retention window in seconds for deleted events kept in holding DB
# Used by startup catch-up and periodic expiration cleanup
# Must be greater than 0
# CLI: --holding-retention-secs <seconds>
# Default: 7776000 (90 days)
# NGIT_HOLDING_RETENTION_SECS=7776000

# Interval in seconds between holding DB and deletion-request retention background
# cleanup passes. This cadence does not alter timestamp-derived retention deadlines.
# Must be greater than 0
# CLI: --holding-cleanup-interval-secs <seconds>
# Default: 86400 (24 hours)
# NGIT_HOLDING_CLEANUP_INTERVAL_SECS=86400

# ============================================================================
# GRASP-05 ARCHIVE MODE
# ============================================================================

# Accept all repository announcements (⚠️ WARNING: Storage/bandwidth risk)
# When enabled, any repository can be mirrored to this relay
# CLI: --archive-all
# Default: false
# NGIT_ARCHIVE_ALL=false

# Whitelist specific repos/pubkeys/identifiers for archiving
# Comma-separated list supporting three formats:
#   <npub>              - Archive all repos from this pubkey
#   <npub>/<identifier> - Archive specific repo
#   <identifier>        - Archive repos with this identifier (any pubkey)
#
# CLI: --archive-whitelist <list>
# Default: (empty)
# Examples:
#   NGIT_ARCHIVE_WHITELIST=npub1alice...
#   NGIT_ARCHIVE_WHITELIST=npub1alice...,npub1bob.../linux
#   NGIT_ARCHIVE_WHITELIST=bitcoin-core,linux,rust
# NGIT_ARCHIVE_WHITELIST=

# Archive GRASP services: comma-separated list of GRASP server domains to archive
# Archives all repositories from the specified GRASP server domains
# Must be bare domains only (e.g., git.example.com, NOT wss://git.example.com)
# Mutually exclusive with NGIT_ARCHIVE_ALL and NGIT_ARCHIVE_WHITELIST
# Automatically sets NGIT_ARCHIVE_READ_ONLY to true by default
# CLI: --archive-grasp-services <list>
# Default: (empty)
# Examples:
#   NGIT_ARCHIVE_GRASP_SERVICES=git.example.com
#   NGIT_ARCHIVE_GRASP_SERVICES=git.example.com,git.nostr.dev,relay.gitnostr.com
# NGIT_ARCHIVE_GRASP_SERVICES=

# Archive read-only mode (relay is read-only sync of archived repositories)
# When true:
#   - NIP-11 includes GRASP-05 in supported_grasps
#   - NIP-11 curation field describes archive scope
#   - Repository announcements not listing this service are accepted per whitelist/archive-all
# When false:
#   - Archive mode disabled (standard GRASP-01 operation)
#
# CLI: --archive-read-only
# Default: true if NGIT_ARCHIVE_ALL, NGIT_ARCHIVE_WHITELIST, or NGIT_ARCHIVE_GRASP_SERVICES is set, false otherwise
# Note: Setting to true without archive config causes startup error
# Note: Cannot be used with NGIT_REPOSITORY_WHITELIST (mutually exclusive)
# NGIT_ARCHIVE_READ_ONLY=

# ============================================================================
# GRASP-06 CONTRIBUTOR PR SUBMISSION
# ============================================================================

# Enable GRASP-06 contributor PR submission endpoint at /prs/<npub>/<identifier>.git
#
# When enabled, the relay exposes an unauthenticated PR submission endpoint that
# accepts pushes of refs/nostr/<event-id> from any contributor. Security relies
# on the signed PR/PR-Update events the refs reference, not on HTTP-level auth.
#
# When disabled (default), /prs/* returns 404 and event-acceptance is unchanged.
#
# See: https://github.com/DanConwayDev/grasp/blob/main/06.md
# See: docs/explanation/grasp-06-contributor-pr-submission.md
#
# CLI: --grasp06-enable
# Default: false
# NGIT_GRASP06_ENABLE=false

# ============================================================================
# DELETION REQUESTS (NIP-09 AND NIP-62)
# ============================================================================

# Deletion request disrespector: ignore NIP-09 and NIP-62 requests (archival mode)
#
# When enabled, incoming NIP-09 (kind 5) deletion requests and NIP-62
# request-to-vanish events are STORED but NOT acted upon: their targets remain
# fully accessible. This makes the relay an archival server, preserving content
# and preventing "left-pad" scenarios. NIP-11 supported_nips will NOT advertise
# NIP-09 (deletion) or NIP-62 (request to vanish) in this mode.
#
# This ONLY affects NIP-09 and NIP-62 user-initiated requests. It does NOT
# prevent blacklist-triggered deletions (operator moderation: spam/malware/abuse).
#
# When disabled (default), both request types are honoured: their targets are
# deleted and re-submission stays rejected. NIP-09 and NIP-62 are advertised in
# NIP-11.
#
# See: docs/explanation/repository-lifecycle.md
#
# CLI: --deletion-request-disrespector
# Default: false
# NGIT_DELETION_REQUEST_DISRESPECTOR=false

# Deletion-request retention applies to accepted NIP-09 deletion requests and
# NIP-62 request-to-vanish events. All values are integer seconds. Unused clocks
# start at relay-observed first_seen_at; used clocks start at last_used_at.
# "Additional" periods begin after their corresponding served period ends.
# Used requests remain served indefinitely when deletion-request-disrespector is true.
# Seconds permit short tests; production periods should be at least one day and
# comfortably exceed worst-case deletion/archive processing time.

# How long an unused request remains served from first_seen_at
# CLI: --deletion-request-retention-unused-served-secs <seconds>
# Default: 2592000 (30 days)
# NGIT_DELETION_REQUEST_RETENTION_UNUSED_SERVED_SECS=2592000

# Additional time an unused request remains unserved but eligible to gate
# CLI: --deletion-request-retention-unused-unserved-gating-additional-secs <seconds>
# Default: 15552000 (180 days)
# NGIT_DELETION_REQUEST_RETENTION_UNUSED_UNSERVED_GATING_ADDITIONAL_SECS=15552000

# Normal-mode time a used request remains served after last_used_at
# CLI: --deletion-request-retention-used-served-after-last-used-secs <seconds>
# Default: 23328000 (270 days; 9 fixed 30-day months)
# NGIT_DELETION_REQUEST_RETENTION_USED_SERVED_AFTER_LAST_USED_SECS=23328000

# Additional normal-mode time a used request remains unserved but continues gating
# CLI: --deletion-request-retention-used-unserved-gating-additional-secs <seconds>
# Default: 7776000 (90 days; 3 fixed 30-day months)
# NGIT_DELETION_REQUEST_RETENTION_USED_UNSERVED_GATING_ADDITIONAL_SECS=7776000

# ============================================================================
# REPOSITORY WHITELIST
# ============================================================================

# Whitelist specific repos/pubkeys/identifiers for GRASP-01 acceptance
# Comma-separated list supporting three formats (same as archive whitelist):
#   <npub>              - Accept all repos from this pubkey (if they list our service)
#   <npub>/<identifier> - Accept specific repo (if it lists our service)
#   <identifier>        - Accept repos with this identifier (if they list our service)
#
# Difference from archive whitelist:
#   - Repository whitelist: Announcements MUST list our service AND match whitelist
#   - Archive whitelist: Announcements don't need to list our service, just match whitelist
#
# CLI: --repository-whitelist <list>
# Default: (empty - all repos listing our service are accepted)
# Examples:
#   NGIT_REPOSITORY_WHITELIST=npub1alice...
#   NGIT_REPOSITORY_WHITELIST=npub1alice...,npub1bob.../linux
#   NGIT_REPOSITORY_WHITELIST=bitcoin-core,linux,rust
# Note: Cannot be used with NGIT_ARCHIVE_READ_ONLY=true (mutually exclusive)
# Note: When set, NIP-11 curation field will indicate curated repository acceptance
# NGIT_REPOSITORY_WHITELIST=

# ============================================================================
# REPOSITORY BLACKLIST
# ============================================================================

# Blacklist specific repos/pubkeys/identifiers to reject
# Comma-separated list supporting three formats (same as whitelist formats):
#   <npub>              - Block all repos from this pubkey
#   <npub>/<identifier> - Block specific repo
#   <identifier>        - Block repos with this identifier (any pubkey)
#
# Blacklist takes precedence over ALL whitelists:
#   - Blacklisted repos are rejected even if they match archive or repository whitelists
#   - Blacklisted repos are rejected even if they list our service
#
# Rejection reasons indicate the match type:
#   - "Repository owner <npub> is blacklisted" (npub format)
#   - "Repository <npub>/<identifier> is blacklisted" (npub/identifier format)
#   - "Repository identifier <identifier> is blacklisted" (identifier format)
#
# CLI: --repository-blacklist <list>
# Default: (empty - no repositories are blacklisted)
# Examples:
#   NGIT_REPOSITORY_BLACKLIST=npub1spam...
#   NGIT_REPOSITORY_BLACKLIST=npub1alice.../bad-repo
#   NGIT_REPOSITORY_BLACKLIST=malware-repo,spam-repo
# NGIT_REPOSITORY_BLACKLIST=

# Automatically restore repositories that were previously deleted by blacklist
# parity when they are no longer blacklisted and still within holding retention.
# Runs once on startup as part of startup parity orchestration.
# CLI: --blacklist-auto-restore
# Default: false
# NGIT_BLACKLIST_AUTO_RESTORE=false

# ============================================================================
# EVENT BLACKLIST
# ============================================================================

# Blacklist events from specific authors (npubs)
# Comma-separated list of npubs whose events are rejected
# ALL events from these authors are blocked from both relay storage and purgatory
#
# Event blacklist takes precedence over ALL other validation:
#   - Blacklisted events are rejected before any other policy checks
#   - Applies to announcements, state events, PRs, and all other event types
#   - Events never reach purgatory (rejected immediately)
#
# Rejection reason:
#   - "Event author <npub> is blacklisted"
#
# CLI: --event-blacklist <list>
# Default: (empty - no events are blacklisted by author)
# Examples:
#   NGIT_EVENT_BLACKLIST=npub1spam...
#   NGIT_EVENT_BLACKLIST=npub1spam...,npub1abuser...
# NGIT_EVENT_BLACKLIST=

# ============================================================================
# RATE LIMITING & DOS PROTECTION
# ============================================================================

# Maximum total connections to the relay
# When unset (default), connections are unlimited (defers to OS fd limits and infrastructure controls)
# CLI: --max-connections <count>
# Default: unlimited
# NGIT_MAX_CONNECTIONS=4096

# ============================================================================
# GRASP-P PRIVATE REPOSITORIES — CORE (Phase 1)
# ============================================================================
# Multi-tenant private repo hosting: kind-30640 registrations, 30641 state
# roots, 1059/21059 wraps, Blossom-style blob routes, quota ledger. All
# knobs below are no-ops unless NGIT_PRIVATE_REPOS_ENABLE=true.

# Master switch: enable private repository hosting.
# CLI: --private-repos-enable
# Default: false
# NGIT_PRIVATE_REPOS_ENABLE=false

# Admission mode for NEW private-repo aliases: open (any tenant),
# whitelist (only NGIT_PRIVATE_TENANT_WHITELIST npubs), pow (NIP-13 on the
# 30640), paid (reserved; fails validation). WP-E: the shipped default is
# whitelist — open is staging/self-use only (in open mode any fresh key
# receives the full per-tenant quota, so ~50 pseudonymous tenants can
# exhaust the global budget). Part of the policy_fingerprint preimage
# (grasp-p-policy-v2): operators who never set the mode will see their
# fingerprint change on upgrade — paired nodes must upgrade together or
# set the mode explicitly.
# CLI: --private-registration-mode <open|whitelist|pow|paid>
# Default: whitelist
# NGIT_PRIVATE_REGISTRATION_MODE=whitelist

# NIP-13 leading-zero bits required on kind-30640 registrations when
# mode=pow. Must be 1..=40.
# CLI: --private-pow-bits <bits>
# Default: 20
# NGIT_PRIVATE_POW_BITS=20

# Comma-separated npubs allowed to register new aliases when
# mode=whitelist. Empty (default) rejects ALL new registrations — a valid
# "accept nothing" posture; startup warns loudly in that state. Part of
# the policy_fingerprint preimage: paired nodes must run identical lists.
# CLI: --private-tenant-whitelist <npub>[,<npub>...]
# Default: (empty)
# NGIT_PRIVATE_TENANT_WHITELIST=npub1...,npub1...

# Per-blob size cap in bytes (enforced pre- and mid-stream).
# CLI: --private-max-blob-bytes <bytes>
# Default: 268435456 (256 MiB)
# NGIT_PRIVATE_MAX_BLOB_BYTES=268435456

# Serialized-JSON size cap for private-repo events (30640/30641/1059/21059).
# CLI: --private-max-event-bytes <bytes>
# Default: 131072 (128 KiB)
# NGIT_PRIVATE_MAX_EVENT_BYTES=131072

# Per hosting-npub total quota in bytes (events + blobs). Must be > 0 and
# <= NGIT_PRIVATE_GLOBAL_BUDGET_BYTES. policy_fingerprint preimage member.
# CLI: --private-quota-tenant-bytes <bytes>
# Default: 1073741824 (1 GiB)
# NGIT_PRIVATE_QUOTA_TENANT_BYTES=1073741824

# Per-alias total quota in bytes (events + blobs). Must be > 0 and
# <= NGIT_PRIVATE_QUOTA_TENANT_BYTES. policy_fingerprint preimage member.
# CLI: --private-quota-repo-bytes <bytes>
# Default: 536870912 (512 MiB)
# NGIT_PRIVATE_QUOTA_REPO_BYTES=536870912

# Whole private-subsystem storage cap in bytes. policy_fingerprint
# preimage member.
# CLI: --private-global-budget-bytes <bytes>
# Default: 53687091200 (50 GiB)
# NGIT_PRIVATE_GLOBAL_BUDGET_BYTES=53687091200

# Maximum registrations (aliases) per hosting npub.
# CLI: --private-max-aliases-per-tenant <count>
# Default: 64
# NGIT_PRIVATE_MAX_ALIASES_PER_TENANT=64

# Maximum `w` + `aux` keys per alias registration.
# CLI: --private-max-write-keys-per-alias <count>
# Default: 64
# NGIT_PRIVATE_MAX_WRITE_KEYS_PER_ALIAS=64

# Kind-30641 edition ring depth kept in the private meta store.
# CLI: --private-state-history-editions <count>
# Default: 16
# NGIT_PRIVATE_STATE_HISTORY_EDITIONS=16

# Grace period in seconds before an unreferenced blob may be deleted by GC.
# CLI: --private-gc-grace-secs <seconds>
# Default: 86400
# NGIT_PRIVATE_GC_GRACE_SECS=86400

# Interval in seconds between private blob GC passes.
# CLI: --private-gc-interval-secs <seconds>
# Default: 3600
# NGIT_PRIVATE_GC_INTERVAL_SECS=3600

# Tombstoned-alias purge delay in seconds.
# CLI: --private-offboard-retention-secs <seconds>
# Default: 2592000 (30 days)
# NGIT_PRIVATE_OFFBOARD_RETENTION_SECS=2592000

# Blob store root. Unset (default): <relay_data_path>/blobs.
# CLI: --private-blob-data-path <path>
# Default: unset
# NGIT_PRIVATE_BLOB_DATA_PATH=/var/lib/ngit-grasp/blobs

# Private meta store (heed env) root. Unset (default):
# <relay_data_path>/private-meta.
# CLI: --private-meta-data-path <path>
# Default: unset
# NGIT_PRIVATE_META_DATA_PATH=/var/lib/ngit-grasp/private-meta

# ============================================================================
# GRASP-P PRIVATE REPOSITORIES — MIRROR & SYNC (Phase 2)
# ============================================================================

# Blob mirroring between paired nodes.
# CLI: --private-mirror-enable
# Default: false
# NGIT_PRIVATE_MIRROR_ENABLE=false

# Comma-separated peer blob-server base URLs for the mirror. Unset
# (default): derive peers from each registration's `server` tags (minus
# this node's own domain).
# CLI: --private-mirror-peer-urls <url>[,<url>...]
# Default: unset
# NGIT_PRIVATE_MIRROR_PEER_URLS=https://peer.example.com

# Maximum concurrent blob mirror fetches. Must be > 0 when the mirror is
# enabled.
# CLI: --private-mirror-max-concurrency <count>
# Default: 4
# NGIT_PRIVATE_MIRROR_MAX_CONCURRENCY=4

# Per-blob mirror fetch timeout in seconds. Must be > 0 when the mirror is
# enabled.
# CLI: --private-mirror-fetch-timeout-secs <seconds>
# Default: 120
# NGIT_PRIVATE_MIRROR_FETCH_TIMEOUT_SECS=120

# Comma-separated operator-approved peer relay URLs for private-repo sync.
# Outbound private-sync WebSocket connections are made ONLY to this
# allowlist — tenant 30640 `relays` tags never trigger a connection
# (SSRF / membership-map-leak guard). Unset (default): no private-sync
# peer connections are initiated (bootstrap relays still carry the
# private filters).
# CLI: --private-sync-peer-urls <url>[,<url>...]
# Default: unset
# NGIT_PRIVATE_SYNC_PEER_URLS=wss://peer.example.com

# SSRF guard: allow the blob mirror to fetch from peers resolving to
# loopback/private/link-local IPs (and over plain http), and private-sync
# peer relays over plain ws:// or on internal IPs. Default false —
# production drops such peers and only fetches over https/wss from public
# hosts. Set true only for local testing (e.g. a 127.0.0.1 node pair).
# CLI: --private-mirror-allow-private-ips
# Default: false
# NGIT_PRIVATE_MIRROR_ALLOW_PRIVATE_IPS=false

# Accept kind-3313 direct invites for storage (currently only =false is
# honored: invites are rejected).
# CLI: --private-accept-direct-invites
# Default: false
# NGIT_PRIVATE_ACCEPT_DIRECT_INVITES=false

# Opt in to per-tenant metric labels (default: aggregate metrics only, to
# keep label cardinality bounded).
# CLI: --private-per-tenant-metrics
# Default: false
# NGIT_PRIVATE_PER_TENANT_METRICS=false

# ============================================================================
# GRASP-P PRIVATE REPOSITORIES — RATE LIMITS (Phase 4b)
# ============================================================================
# NOTE: the GRASP-P master switch and the rest of the private-repo knobs are
# documented in the sections above; the Phase-4b rate-limit knobs below
# tune abuse posture operators most often want to adjust.

# Per-write-key token bucket capacity for CLIENT-submitted private writes
# (kind 30641/1059/21059 events + blob PUTs). 0 = unlimited (limiter off).
# The default is deliberately generous: legitimate client flows — including
# cord-git widen->narrow key rotations — must never trip it; only abuse
# floods (e.g. quota-uncharged 21059 spam) get capped. Synced/replayed
# traffic bypasses this limiter (node-local DoS protection only).
# CLI: --private-write-rate-capacity <count>
# Default: 120
# NGIT_PRIVATE_WRITE_RATE_CAPACITY=120

# Refill rate (tokens per minute) for the per-write-key client write bucket.
# Must be > 0 when NGIT_PRIVATE_WRITE_RATE_CAPACITY is non-zero.
# CLI: --private-write-rate-refill-per-min <count>
# Default: 60
# NGIT_PRIVATE_WRITE_RATE_REFILL_PER_MIN=60

# Per-(tenant, alias) token bucket capacity for same-tenant kind-30640
# REPLACEMENTS (free addressable replacements re-trigger sync index rebuilds
# + filter re-issues to all peers within seconds). 0 = unlimited. Keep the
# burst >= 4: a revocation rotation is widen->narrow = 2 replacements in
# quick succession, plus client error retries. Rejected replacements are
# HELD locally and retried after bucket refill (the hourly re-issue is the
# backstop healer).
# Cross-node acceptance knob: paired nodes MUST run identical values (it is
# part of the policy_fingerprint preimage, v2).
# CLI: --private-registration-replace-capacity <count>
# Default: 8
# NGIT_PRIVATE_REGISTRATION_REPLACE_CAPACITY=8

# Refill rate (replacements per hour) for the per-(tenant, alias)
# replacement bucket — bounds SUSTAINED replacement floods. Must be > 0
# when NGIT_PRIVATE_REGISTRATION_REPLACE_CAPACITY is non-zero.
# CLI: --private-registration-replace-refill-per-hour <count>
# Default: 4
# NGIT_PRIVATE_REGISTRATION_REPLACE_REFILL_PER_HOUR=4

# Interval (seconds) for the periodic since=None full re-issue of the
# private sync filters (Layer-1 kind-30640 + the current derived 30641/1059
# filters) to every live peer, with a small random jitter to avoid
# cross-node lockstep. Heals delivery gaps that otherwise only a reconnect
# or the daily fresh sync fixes: expired rejected-hot-cache entries,
# negentropy blind spots, and cadence-limited 30640 rejections (see
# NGIT_PRIVATE_REGISTRATION_REPLACE_*) that deliberately rely on
# redelivery. 0 = disabled. Node-local recovery knob only — acceptance is
# unaffected, so paired nodes may run different values (NOT part of the
# policy_fingerprint preimage).
# CLI: --private-full-reissue-interval-secs <seconds>
# Default: 3600
# NGIT_PRIVATE_FULL_REISSUE_INTERVAL_SECS=3600

# Minimum interval (seconds) between private sync-filter re-issues to the
# same peer, across BOTH triggers (PrivateSyncIndex-change-derived filter
# pushes and the hourly full re-issue). Bounds how often a churning
# derived-filter set can force a full consolidate (unsubscribe-all +
# resubscribe + since=None backfill) on a peer: past the 70-filter
# consolidation threshold, every index-dirty 5s tick used to consolidate
# again. A re-issue skipped by this floor is retried once the interval
# lapses (never dropped). 0 = unlimited. Node-local recovery knob only —
# paired nodes may run different values (NOT part of the
# policy_fingerprint preimage).
# CLI: --private-reissue-min-interval-secs <seconds>
# Default: 30
# NGIT_PRIVATE_REISSUE_MIN_INTERVAL_SECS=30

# Base delay (seconds) for the blob mirror's per-blob exponential retry
# backoff: after n consecutive fetch failures the next attempt waits
# base * 2^(n-1), capped at NGIT_PRIVATE_MIRROR_RETRY_MAX_SECS, ±20% jitter.
# Applies to transient failure classes only (transport errors, peer HTTP
# 5xx, no available peer, and 404-on-all-peers — the latter always at the
# max interval for late uploads). Deterministic classes (quota, too_large,
# verify/store/blocked, reserve/sink) are NOT gated: they keep the flat
# repair-scan cadence and succeed once the underlying condition changes.
# Must be > 0 when the mirror is enabled. Node-local recovery knob — NOT
# part of the policy_fingerprint preimage.
# CLI: --private-mirror-retry-base-secs <seconds>
# Default: 60
# NGIT_PRIVATE_MIRROR_RETRY_BASE_SECS=60

# Cap (seconds) for the blob mirror retry backoff; also the fixed retry
# interval for blobs the peers answer 404 (possible late upload). Must be
# >= NGIT_PRIVATE_MIRROR_RETRY_BASE_SECS.
# CLI: --private-mirror-retry-max-secs <seconds>
# Default: 3600
# NGIT_PRIVATE_MIRROR_RETRY_MAX_SECS=3600

# ============================================================================
# GRASP-P PRIVATE REPOSITORIES — DENYLIST / TAKEDOWN (Phase 4b)
# ============================================================================
# Node-local legal takedown list: blob sha256 digests this node must not
# serve (GET/HEAD -> 451), accept (upload preflight -> 451), store
# (in-flight uploads fail at commit), or mirror. Paired nodes in different
# jurisdictions may legitimately run different lists — the denylist is
# deliberately NOT part of the policy_fingerprint.

# Comma-separated list of denylist files (per-node / per-jurisdiction
# lists), each with one sha256 hex digest per line. A MISSING file is
# tolerated (warning + treated as empty); a present-but-unreadable file is
# a hard boot error. Each file is capped (64 MiB / 1M lines): an over-cap
# file is a hard boot error and keeps its last-known entries on reload.
# Writers MUST update files atomically (write-temp-then-rename) — the
# reload keys off mtime, and a torn write is a known staleness window.
# Unset = empty denylist.
# CLI: --private-denylist-path <path>[,<path>...]
# Default: unset
# NGIT_PRIVATE_DENYLIST_PATH=/etc/ngit-grasp/denylist.txt

# Interval (seconds) between denylist file reloads. Only changed files are
# re-read; the live set is swapped atomically. Hashes NEWLY present after
# a reload trigger an immediate purge: all claims freed (ledger charges
# released), bytes unlinked, and the five mirror skip sites keep the blob
# from being re-fetched. Hashes REMOVED from the files unblock reads, but
# bytes already purged stay gone — clients must re-upload. 0 = reload
# disabled (the boot-time set is kept).
# CLI: --private-denylist-reload-secs <seconds>
# Default: 60
# NGIT_PRIVATE_DENYLIST_RELOAD_SECS=60
